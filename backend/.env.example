# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL. The test suite uses TEST_DATABASE_URL and never touches this database.
DATABASE_URL=postgresql://localhost:5432/vaultix
TEST_DATABASE_URL=postgresql://localhost:5432/vaultix_test

# Authentication policy
SESSION_TTL_HOURS=12
INVITATION_TTL_HOURS=72
PASSWORD_MIN_LENGTH=12
REQUIRE_ADMIN_APPROVAL=true
DEVICE_CHALLENGE_TTL_MINUTES=5
CORS_ORIGINS=http://localhost:5173

# Encrypted file storage. In production FILE_ENCRYPTION_KEK is required and must
# be a Base64-encoded 32-byte key held outside the repository. Development and
# test environments generate a local key file automatically when it is absent.
FILE_STORAGE_DIR=./storage
FILE_MAX_UPLOAD_BYTES=26214400
# FILE_ENCRYPTION_KEK=
# FILE_ENCRYPTION_KEY_FILE=./storage/.master-key

# Bootstrap administrator (used only by `pnpm db:seed-admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
